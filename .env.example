# ─── FB ACCESS TOKENS (copy y nguyên từ Railway env của fb_chatbot) ────────────
FB_TOKEN_BM1=EAA...
FB_TOKEN_BM2=EAA...
FB_TOKEN_BM3=EAA...

# ─── NGƯỠNG KPI ────────────────────────────────────────────────────────────────
# ToFu (tên campaign có "GC", "CT1", hoặc "CT2"): Mess ≤ TOFU_MESS_MAX
TOFU_MESS_MAX=60000
TOFU_MIN_SPEND=20000

# BoFu (tất cả còn lại): Mess ≤ BOFU_MESS_MAX VÀ ROAS ≥ BOFU_ROAS_MIN
BOFU_MESS_MAX=100000
BOFU_ROAS_MIN=2.5
BOFU_MIN_SPEND=50000

# ─── REFRESH ───────────────────────────────────────────────────────────────────
REFRESH_INTERVAL_HOURS=3        # refresh data từ FB API mỗi 3h
AUTO_PAUSE_INTERVAL_HOURS=8     # job auto-pause chạy mỗi 8h (chậm hơn refresh)
AUTO_PAUSE_LOOKBACK_DAYS=7      # rule scan cumulative N ngày qua (chi > 200K trong N ngày)

# ─── APP PASSWORD ──────────────────────────────────────────────────────────────
APP_PASSWORD=Eyeplus123@@       # Mật khẩu đăng nhập app, đổi để bảo mật hơn

# ─── REMOTE LICENSE (admin control) ───────────────────────────────────────────
# Admin maintain whitelist on Railway. App ping mỗi 6h.
# Nếu key không trong whitelist → app exit lần ping kế.
# Để trống = không check license (dev/internal)
LICENSE_CHECK_URL=
LICENSE_KEY=
LICENSE_CHECK_INTERVAL_HOURS=6

# ─── AUTO-PAUSE ────────────────────────────────────────────────────────────────
# Khi true, app tự gọi FB API pause ads đạt rule auto-pause:
#   TOFU: chi > 200K VÀ cost/mess > 60K VÀ ROAS = 0
# Đổi sang false để tắt hoàn toàn (chỉ flag, không action).
ENABLE_AUTO_PAUSE=true
